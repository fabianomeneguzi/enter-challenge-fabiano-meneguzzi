# Copy this file to .env and fill in your key (no quotes needed).
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Advisor login — set in Render → Environment (and in your local .env only; do not commit .env)
# SESSION_SECRET: e.g. openssl rand -hex 32
SESSION_SECRET=
ADVISOR_LOGIN_EMAIL=
ADVISOR_LOGIN_PASSWORD=
